// Debug/self-test switches (build.py --check, boss.bat).
// nosave, NOT server: an archived value beats the default, so a
// server cvar left set by one test run silently leaks into every
// later launch (wolf_dbg_arm did exactly that � normal play
// started fully armed). These now always begin at 0 and only take
// effect when a launcher passes +set explicitly.
nosave int wolf_dbg_check = 0;      // harness map-load heartbeat
nosave int wolf_dbg_doortest = 0;
nosave int wolf_dbg_alert = 0;
nosave int wolf_dbg_pickup = 0;
nosave int wolf_dbg_weapon = 0;
nosave int wolf_dbg_forcefire = 0;
nosave int wolf_dbg_exit = 0;
nosave int wolf_dbg_sight = 0;
nosave int wolf_dbg_death = 0;
nosave int wolf_dbg_arm = 0;
nosave int wolf_dbg_boss = 0;
nosave int wolf_dbg_victory = 0;
nosave int wolf_dbg_jump = 0;       // CheckJump precondition probe
nosave int wolf_dbg_skin = 0;       // uniform-recolor remap probe
nosave int wolf_dbg_lobby = 0;      // lobby-flow walk-through probe
nosave int wolf_dbg_net = 0;        // lockstep divergence beacon
nosave int wolf_dbg_kill = 0;       // scripted netgame kill probe
nosave int wolf_dbg_font = 0;       // font identity probe
nosave int wolf_dbg_ghost = 0;      // Pac-Man ghost behavior probe
nosave int wolf_dbg_bosskill = 0;   // extra-boss floor-survival probe
nosave int wolf_dbg_coopsight = 0;  // co-op dormant-sight probe
nosave int wolf_dbg_menutest = 0;   // netgame menu-persistence probe
nosave int wolf_dbg_sodboss = 0;    // Spear boss behaviour probe
nosave int wolf_dbg_signs = 0;      // lobby signage probe
user string wolf_mp_request = "";    // menu -> launcher handoff:
// USER scope on purpose - server cvars apply on game tics, and menus
// PAUSE the game, so a set made in the menu died before the quit

// Player Setup: uniform color 0-3 (grey/blue/red/tan). Userinfo so
// each player's choice replicates in netgames and archives locally.
user int wolf_skin = 0;

// Modernization source of truth. The engine's sv_jump/sv_crouch/
// sv_freelook tri-states never archive (absent from LocalServerInfo),
// so a fresh launch reads 0 = allowed while the menu showed OFF - the
// menu could not track. These archive like any user cvar; play code
// pushes them into the sv gates at level load (host's values rule in
// netgames), and the menu reads/writes only these.
user int wolf_mod_jump = 0;
user int wolf_mod_crouch = 0;
user int wolf_mod_freelook = 0;
user int wolf_mod_tp = 0;       // third-person view (chasecam.zs)
user int wolf_mod_flats = 0;    // textured floors/ceilings (flats.zs)
user int wolf_xhair_color = 0;  // crosshair color preset index (menu)
user int wolf_mod_light = 0;    // enhanced lighting (lighting.zs)
user int wolf_mod_hdtex = 0;    // RMST HD textures (next launch, mod_args)
user int wolf_mod_hdsfx = 0;    // RMST HD sounds (next launch, mod_args)
server string wolf_dbg_openmenu = "";   // dev probe: open a submenu from menu code
