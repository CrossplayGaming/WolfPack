// WolfDoom — MAPINFO (Phase 1 bootstrap)
// Standalone IPK3: gameinfo defines the base game so no Doom IWAD is needed.

gameinfo
{
    playerclasses = "WolfPlayer"
    EventHandlers = "WolfDebugHandler", "WolfLevel",
                    "WolfGameState", "WolfDeathHandler",
                    "WolfScreenFX", "WolfDeathCam", "WolfAttract",
                    "WolfLobby", "WolfFlats", "WolfChaseXhair", "WolfLighting",
                    "WolfMusic"
    // DrawPlayBorder (WL_GAME.C:841): palette 127 surround with a 1-unit
    // inset bevel, not Doom's 8-unit decorative border.
    borderflat = "FLOOR7F"
    border = 1, 1, "BRDR_TL", "BRDR_T", "BRDR_TR", "BRDR_L", "BRDR_R",
                   "BRDR_BL", "BRDR_B", "BRDR_BR"
    statusbarclass = "WolfStatusBar"
    // standalone IWAD: the engine needs these declared even when
    // NoIntermission suppresses the tally (the real Wolf
    // LevelCompleted screen replaces them in the tally pass).
    statscreen_single = "WolfIntermission"
    statscreen_coop = "CoopStatusScreen"
    statscreen_dm = "DeathmatchStatusScreen"
    drawreadthis = false
    messageboxclass = "WolfMessageBox"
    CursorPic = "M_CURSOR"   // keyed arrow pointer, tip at hotspot
    // the engine's menu dim: BORDCOLOR red at high strength instead of
    // GZDoom's purple, so engine pages sit on a Wolf-red field
    dimcolor = "8a 00 00"
    dimamount = 0.9
    // engine option pages recolored to the Wolf scheme (TEXTCOLO lump
    // defines the Wolf* colors from GAMEPAL entries)
    menufontcolor_title = "WolfYellow"
    menufontcolor_label = "WolfGrey"
    menufontcolor_value = "WolfYellow"
    menufontcolor_action = "WolfGold"
    menufontcolor_highlight = "WolfWhite"
    menufontcolor_selection = "WolfWhite"
    // endStrings (WL_MENU.C:27-38)
    quitmessages = "Dost thou wish to
leave with such hasty
abandon?",
        "Chickening out...
already?",
        "Press N for more carnage.
Press Y to be a weenie.",
        "So, you think you can
quit this easily, huh?",
        "Press N to save the world.
Press Y to abandon it in
its hour of need.",
        "Press N if you are brave.
Press Y to cower in shame.",
        "Heroes, press N.
Wimps, press Y.",
        "For guns and glory, press N.
For work and worry, press Y."
}

// Wolf3D difficulty (WL_DEF.H gd_baby..gd_hard). SpawnFilter is positional:
// converter emits skill1 (all), skill3+ (medium+36 codes), skill4+ (hard+72).
clearskills
skill baby
{
    Name = "Can I play, Daddy?"
    SpawnFilter = 1
    DamageFactor = 0.25   // TakeDamage points>>=2 (charter DIFF-001)
}
skill easy
{
    Name = "Don't hurt me."
    SpawnFilter = 2
}
skill medium
{
    Name = "Bring 'em on!"
    SpawnFilter = 3
    DefaultSkill
}
skill hard
{
    Name = "I am Death incarnate!"
    SpawnFilter = 4
}

DoomEdNums
{
    // converter turn-arrow order: E,NE,N,NW,W,SW,S,SE (DIR8)
    21200 = "WolfTurnE"
    21201 = "WolfTurnNE"
    21202 = "WolfTurnN"
    21203 = "WolfTurnNW"
    21204 = "WolfTurnW"
    21205 = "WolfTurnSW"
    21206 = "WolfTurnS"
    21207 = "WolfTurnSE"
    21210 = "WolfPushwall"
    21211 = "WolfVictoryTrigger"
    21220 = "WolfDoor"
    // E3 secret floor ghosts (converter DIR: blinky/clyde/pinky/inky)
    21040 = "WolfGhostBlinky"
    21041 = "WolfGhostClyde"
    21042 = "WolfGhostPinky"
    21043 = "WolfGhostInky"
}

include "mapinfo_statics.txt"
include "mapinfo_enemies.txt"

// All six episodes, in menu order: StartGameDirect() starts games by
// EPISODE INDEX into this list, so it must match the episode menu.
clearepisodes
// Spear is a single 21-floor campaign: one episode entry keeps
// StartGameDirect working, and the episode page is skipped.
episode MAP01
{
    name = "Spear of Destiny"
}

defaultmap
{
    NoJump
    NoCrouch
    NoFreelook
}

include "mapinfo_sod.txt"

// Multiplayer lobby: Hans's level with the fight stripped, all players
// spawning in the pillared hall. No exit yet - episode doors and skill
// switches arrive with the lobby flow. Menu music: it's a staging area.

// Multiplayer lobby: the same pillared hall as Wolfenstein's, wearing
// Spear's wall set. Skill only - Spear is a single campaign.
map LOBBY "Lobby"
{
    levelnum = 99
    music = "XTIPTOE"
    next = "LOBBY"
}
