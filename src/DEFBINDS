// WolfDoom default binds. Space opens doors (the original's use key);
// no jump or crouch keys exist by default (modernization-menu options
// later); the wheel steps weapons - a no-cost modern convenience.
1 "slot 1"
2 "slot 2"
3 "slot 3"
4 "slot 4"
wheelup "weapprev"
wheeldown "weapnext"
space "+use"
// F1 is the original's help key: it opens the Read This article
// (HelpScreens, WL_MENU.C:349). Without this the engine's own F1
// binding looks for a HELP graphic we do not ship and draws the
// missing-texture check pattern.
F1 "openmenu WolfReadMenu"
