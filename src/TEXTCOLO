// Wolf-palette text colors as GRADIENTS: NewSmallFont's glyphs carry a
// built-in dark outline, and a flat single-color range recolors those
// edge pixels too - which is what erased the outlines. A range from
// black to the target keeps dark pixels dark.
"WolfGrey"      { #000000 #8E8E8E  Flat: #8E8E8E }
"WolfWhite"     { #000000 #C3C3C3  Flat: #C3C3C3 }
"WolfYellow"    { #141300 #FFF700  Flat: #FFF700 }
"WolfGold"      { #100F00 #B6AE00  Flat: #B6AE00 }
"WolfDarkRed"   { #000000 #710000  Flat: #710000 }
