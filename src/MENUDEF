// WolfDoom MENUDEF — every entry point routes to the Wolf menu stack.
//
// "MainMenu" is the engine's own front door (Esc in game, key at title),
// so overriding its descriptor is what buries the Doom menu. The other
// descriptors exist so Menu.SetMenu() finds a ListMenuDescriptor to hand
// our classes; the items live in ZScript, not here.

LISTMENU "MainMenu"
{
    Class "WolfMainMenu"
}

LISTMENU "WolfOptionsMenu"
{
    Class "WolfOptionsMenu"
}

LISTMENU "WolfEpisodeMenu"
{
    Class "WolfEpisodeMenu"
}

